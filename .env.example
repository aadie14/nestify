# Nestify production environment template
# Copy to .env and fill with your real secrets.

# Core server
HOST=0.0.0.0
PORT=8000
NESTIFY_LOG_LEVEL=INFO

# Deployment providers (required for public live URLs)
# Static deployments (Vercel/Netlify)
VERCEL_TOKEN=
NETLIFY_API_TOKEN=

# Backend deployments (Fly/Railway/Render)
FLY_API_TOKEN=
FLY_ORGANIZATION_ID=
RAILWAY_API_KEY=
RAILWAY_WORKSPACE_ID=
RENDER_API_KEY=

# Google Cloud Platform (Cloud Run/App Engine — FREE TIER)
# Cloud Run free tier: 2M requests/month, scale-to-zero = $0 when idle
GCP_PROJECT_ID=
# Provide raw JSON or a path to the service account key file
GCP_SERVICE_ACCOUNT_JSON=
GCP_ARTIFACT_REPOSITORY=nestify
GCP_REGION=us-central1
# Block deployments that would exceed free tier estimates
GCP_FREE_TIER_GUARD=true

# GitHub source import + temporary repo publishing
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=

# LLM providers (recommended for richer fix/security intelligence)
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# Secret store configuration (managed secrets, no .env required)
# Vault
VAULT_ADDR=
VAULT_TOKEN=
VAULT_KV_PATH=secret
# GCP Secret Manager
GOOGLE_CLOUD_PROJECT=
# AWS Secrets Manager
AWS_DEFAULT_REGION=
# Local encrypted store fallback
NESTIFY_MASTER_KEY=
NESTIFY_SECRET_DB=app/secrets.db

# Agent behavior
AGENTIC_MODE_ENABLED=true
AGENTIC_LEARNING_ENABLED=true
NESTIFY_ENABLE_LLM_FIXES=true
NESTIFY_SECURITY_THRESHOLD=70
NESTIFY_ENFORCE_SECURITY_THRESHOLD=false

# Docker/runtime controls
DOCKER_MAX_MEMORY=1g
DOCKER_MAX_CPU=1.0
DOCKER_TIMEOUT=300

# Monitoring/load testing
LOAD_TEST_ENABLED=true
LOAD_TEST_DURATION=60
LOAD_TEST_RPS=100
MONITOR_DURATION_HOURS=24
OPTIMIZATION_THRESHOLD=0.6

# Data stores (optional - app has fallbacks)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=nestify
QDRANT_HOST=localhost
QDRANT_PORT=6333
POSTGRES_DSN=

# Reporting/output
NESTIFY_REPORT_DIR=app/outputs/reports
